# Variables para docker-compose. Copiá este archivo a ".env" y ajustá si hace falta.
# Este .env NO reemplaza al de Laravel (backend/.env) — ese lo genera composer/artisan.

# --- App ---
APP_PORT=8080
FRONTEND_PORT=5173

# --- Base de datos (MySQL) ---
DB_DATABASE=proyecto2026
DB_USERNAME=proyecto2026
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root
DB_PORT=3306
